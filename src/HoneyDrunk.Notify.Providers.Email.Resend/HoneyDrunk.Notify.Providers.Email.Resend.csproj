<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package Metadata -->
    <PackageId>HoneyDrunk.Notify.Providers.Email.Resend</PackageId>
    <Version>0.5.1</Version>
    <Authors>HoneyDrunk Studios</Authors>
    <Description>Resend HTTP API email provider for HoneyDrunk.Notify. Delivers email notifications via the Resend transactional email service.</Description>
    <PackageTags>notify;provider;email;resend;notifications;grid</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/HoneyDrunkStudios/HoneyDrunk.Notify</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/HoneyDrunkStudios/HoneyDrunk.Notify</PackageProjectUrl>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HoneyDrunk.Notify.Abstractions\HoneyDrunk.Notify.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HoneyDrunk.Standards" Version="0.4.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="HoneyDrunk.Vault" Version="0.8.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Resend" Version="0.24.0" />
    <!-- Keep Resend's transitive dependency on the patched 10.0 servicing line (GHSA-x33c-w48q-qrgc). -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\HoneyDrunk.Notify.ProviderSupport\OptionsRegistrationExtensions.cs" Link="ProviderSupport\OptionsRegistrationExtensions.cs" />
    <Compile Include="..\HoneyDrunk.Notify.ProviderSupport\SecretStoreExtensions.cs" Link="ProviderSupport\SecretStoreExtensions.cs" />
    <Compile Include="..\HoneyDrunk.Notify.ProviderSupport\ServiceCollectionRegistrationExtensions.cs" Link="ProviderSupport\ServiceCollectionRegistrationExtensions.cs" />
  </ItemGroup>

</Project>
