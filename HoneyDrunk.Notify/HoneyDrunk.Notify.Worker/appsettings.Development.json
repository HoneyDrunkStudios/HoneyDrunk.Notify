{
  "Grid": {
    "StudioId": "honeydrunk",
    "Environment": "development"
  },
  "Notify": {
    "Enabled": true,
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelay": "00:00:02",
      "MaxDelay": "00:01:00"
    },
    "Policy": {
      "EnableDedupe": true,
      "DedupeWindow": "00:10:00"
    },
    "Templates": {
      "RootPath": "templates",
      "Extension": ".txt",
      "CacheEnabled": true,
      "CacheTtl": "00:05:00"
    }
  },
  "NotifyWorker": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "BatchSize": 10,
    "QueueAdapter": "InMemory"
  },
  "Resend": {
    "FromAddress": "noreply@honeydrunk.local",
    "FromDisplayName": "HoneyDrunk Notify"
  },
  "Twilio": {
    "FromNumber": "+15555550100"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "UseSsl": false,
    "FromAddress": "noreply@honeydrunk.local",
    "FromDisplayName": "HoneyDrunk Notify"
  }
}
